# P1: isolated project runtime. See P1_SETUP.md before installation.
APP_PYTHON=backend/.venv-p1/bin/python
APP_ML_MODE=real
ML_ARTIFACT_DIR=ml/artifacts/a4/export/a4-marbert-v1
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
# Supported macOS defaults to Apple Vision (requires Arabic recognition support).
# Explicit portable fallback, only after installing its lock and local weights:
# ML_OCR_ENGINE=easyocr
# ML_EASYOCR_CANVAS=1600
# Optional ports if another local instance uses 8000/5173:
# APP_API_PORT=18174
# APP_WEB_PORT=15174
# V1 rollback: remove ML_ARTIFACT_DIR and restart; retain both model versions.
# Exact stable A4 environment remains backend/.venv-a4-standalone (unchanged).
